# Environment Configuration Example
# This file shows the available configuration options
# Location: docs/.env.example

# Your webhook endpoint URL where invoice data will be sent
INVOICE_WEBHOOK_URL=https://webhook.site/your-unique-id

# Or use a custom API endpoint:
# INVOICE_WEBHOOK_URL=https://api.yourdomain.com/invoices/submit

# API Request Timeout (milliseconds)
REQUEST_TIMEOUT=30000

# Enable debug logging
DEBUG=true

# SETUP INSTRUCTIONS:
# 1. For local testing, use: https://webhook.site/
#    - Go to webhook.site, copy your unique URL
#    - Update INVOICE_WEBHOOK_URL below
#
# 2. For production, use your actual API endpoint:
#    - Set INVOICE_WEBHOOK_URL to your server endpoint
#    - Ensure CORS is configured properly
#
# 3. To use this config:
#    - Load config/env.js in your HTML: <script src="../config/env.js"></script>
#    - Or set the webhook URL in JavaScript:
#      setWebhookUrl('https://your-webhook-url')
#
# 4. Invoice data will be sent as JSON with this structure:
#    {
#      "invoiceNumber": "...",
#      "invoiceDate": "...",
#      "dueDate": "...",
#      "company": { "name": "...", "street": "...", "city": "..." },
#      "client": { "name": "...", "street": "...", "city": "..." },
#      "items": [ { "description": "...", "quantity": 1, "price": 0.00, "amount": 0.00 } ],
#      "taxRate": 0,
#      "subtotal": 0.00,
#      "taxAmount": 0.00,
#      "total": 0.00,
#      "notes": "..."
#    }
